---
import { DOWNVOTE_LABELS, DOWNVOTE_REASONS, type FailureReport } from "../lib/votes";

interface Props {
	postId: string;
	seedUpvotes: number;
	seedReports: FailureReport[];
	sop: string[];
}

const { postId, seedUpvotes, seedReports, sop } = Astro.props;
const config = JSON.stringify({ postId, seedUpvotes, seedReports, sop });
---

<section class="votes" data-votes>
	<script is:inline type="application/json" data-vote-config set:html={config} />
	<h2>Troubleshooting</h2>
	<p class="hint">Failure reports stay on the pack. A downvote needs a category and a step.</p>
	<ul class="reports" data-reports>
		{
			seedReports.length === 0 ? (
				<li class="empty">No failure reports yet.</li>
			) : (
				seedReports.map((report) => (
					<li>
						<span class="tag">{report.reason}</span>
						<span class="meta">step {report.step}</span>
						<span class="detail">{sop[report.step - 1] ?? `step ${report.step}`}</span>
					</li>
				))
			)
		}
	</ul>
	<p class="counts">
		<span data-up-count>{seedUpvotes}</span> useful
		<span class="mine" data-mine></span>
	</p>
	<div class="actions">
		<button type="button" data-up>Mark useful</button>
		<button type="button" data-open-down>Report failure</button>
	</div>
	<dialog data-dialog>
		<form method="dialog" data-down-form>
			<h2>What went wrong?</h2>
			<p class="hint">Pick crash, leak, or error, and the SOP step.</p>
			<p class="err" data-error hidden></p>
			<fieldset>
				<legend class="sr-only">Failure category</legend>
				{
					DOWNVOTE_REASONS.map((reason) => (
						<label>
							<input type="radio" name="reason" value={reason} />
							{DOWNVOTE_LABELS[reason]}
						</label>
					))
				}
			</fieldset>
			<label class="note">
				Which step
				<select name="step">
					<option value="">Select a step</option>
					{
						sop.map((text, i) => (
							<option value={String(i + 1)}>
								{i + 1}. {text}
							</option>
						))
					}
				</select>
			</label>
			<div class="actions">
				<button type="submit" value="save">Save report</button>
				<button type="submit" value="cancel">Cancel</button>
			</div>
		</form>
	</dialog>
</section>

<script>
	import {
		validateDownvote,
		VOTE_STORAGE_KEY,
		type FailureReport,
		type StoredVote,
	} from "../lib/votes";

	type Store = Record<string, StoredVote>;
	type Config = {
		postId: string;
		seedUpvotes: number;
		seedReports: FailureReport[];
		sop: string[];
	};

	function readStore(): Store {
		try {
			const raw = localStorage.getItem(VOTE_STORAGE_KEY);
			if (!raw) return {};
			const parsed = JSON.parse(raw) as Store;
			return parsed && typeof parsed === "object" ? parsed : {};
		} catch {
			return {};
		}
	}

	function writeStore(store: Store) {
		localStorage.setItem(VOTE_STORAGE_KEY, JSON.stringify(store));
	}

	function paint(root: HTMLElement, cfg: Config) {
		const mine = readStore()[cfg.postId];
		const reports: { report: FailureReport; you: boolean }[] = cfg.seedReports.map((report) => ({
			report,
			you: false,
		}));
		if (mine?.kind === "down" && mine.reason && mine.step) {
			reports.push({ report: { reason: mine.reason, step: mine.step }, you: true });
		}
		const list = root.querySelector("[data-reports]");
		if (list) {
			list.replaceChildren();
			if (reports.length === 0) {
				const empty = document.createElement("li");
				empty.className = "empty";
				empty.textContent = "No failure reports yet.";
				list.append(empty);
			} else {
				for (const item of reports) {
					const li = document.createElement("li");
					const tag = document.createElement("span");
					tag.className = "tag";
					tag.textContent = item.report.reason;
					const meta = document.createElement("span");
					meta.className = "meta";
					meta.textContent = item.you ? `step ${item.report.step} · you` : `step ${item.report.step}`;
					const detail = document.createElement("span");
					detail.className = "detail";
					detail.textContent = cfg.sop[item.report.step - 1] ?? `step ${item.report.step}`;
					li.append(tag, meta, detail);
					list.append(li);
				}
			}
		}
		const up = cfg.seedUpvotes + (mine?.kind === "up" ? 1 : 0);
		const upEl = root.querySelector("[data-up-count]");
		const mineEl = root.querySelector("[data-mine]");
		if (upEl) upEl.textContent = String(up);
		if (mineEl) {
			if (mine?.kind === "up") mineEl.textContent = " · you marked useful";
			else if (mine?.kind === "down") mineEl.textContent = " · you reported a failure";
			else mineEl.textContent = "";
		}
	}

	for (const root of document.querySelectorAll<HTMLElement>("[data-votes]")) {
		const raw = root.querySelector("[data-vote-config]")?.textContent ?? "{}";
		const cfg = JSON.parse(raw) as Config;
		const dialog = root.querySelector<HTMLDialogElement>("[data-dialog]");
		const form = root.querySelector<HTMLFormElement>("[data-down-form]");
		const errorEl = root.querySelector<HTMLElement>("[data-error]");
		paint(root, cfg);

		root.querySelector("[data-up]")?.addEventListener("click", () => {
			const store = readStore();
			store[cfg.postId] = { kind: "up" };
			writeStore(store);
			paint(root, cfg);
		});

		root.querySelector("[data-open-down]")?.addEventListener("click", () => {
			if (errorEl) {
				errorEl.hidden = true;
				errorEl.textContent = "";
			}
			form?.reset();
			dialog?.showModal();
		});

		form?.addEventListener("submit", (event) => {
			const submitter = (event as SubmitEvent).submitter as HTMLButtonElement | null;
			if (submitter?.value === "cancel") return;
			event.preventDefault();
			const data = new FormData(form);
			const result = validateDownvote({
				reason: data.get("reason"),
				step: data.get("step"),
				stepCount: cfg.sop.length,
			});
			if (!result.ok) {
				if (errorEl) {
					errorEl.hidden = false;
					errorEl.textContent = result.error;
				}
				return;
			}
			const store = readStore();
			store[cfg.postId] = { kind: "down", reason: result.reason, step: result.step };
			writeStore(store);
			paint(root, cfg);
			dialog?.close();
		});
	}
</script>

<style>
	.votes {
		margin: 0;
		padding: 0;
	}
	.votes > h2 {
		font-size: 0.92rem;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: #8a8f98;
		margin: 0 0 0.35rem;
	}
	.hint {
		margin: 0 0 0.85rem;
		color: #6b717c;
		font-size: 0.9rem;
	}
	.reports {
		list-style: none;
		margin: 0 0 1rem;
		padding: 0;
		display: grid;
		gap: 0.45rem;
	}
	.reports :global(li) {
		font-size: 0.88rem;
		padding: 0.55rem 0.65rem;
		border-radius: 8px;
		background: #f7f8f9;
		display: grid;
		gap: 0.15rem;
	}
	.reports :global(.tag) {
		font-weight: 650;
		text-transform: lowercase;
	}
	.reports :global(.meta) {
		white-space: nowrap;
		color: #6b717c;
		font-size: 0.78rem;
	}
	.reports :global(.detail) {
		color: #3d424c;
	}
	.reports :global(li.empty) {
		color: #8a8f98;
		background: transparent;
		padding-left: 0;
	}
	.counts {
		margin: 0 0 0.75rem;
		color: #6b717c;
		font-size: 0.9rem;
	}
	.actions {
		display: flex;
		gap: 0.5rem;
		flex-wrap: wrap;
	}
	button {
		font: inherit;
		font-size: 0.9rem;
		padding: 0.4rem 0.85rem;
		border: 1px solid #e4e6ea;
		border-radius: 8px;
		background: #fff;
		cursor: pointer;
	}
	button:hover {
		background: #f7f8f9;
	}
	dialog {
		border: 1px solid #e4e6ea;
		border-radius: 12px;
		padding: 1.25rem;
		max-width: 28rem;
		width: calc(100% - 2rem);
	}
	dialog h2 {
		font-size: 1.05rem;
		margin: 0 0 0.35rem;
		text-transform: none;
		letter-spacing: 0;
		color: #1a1d23;
	}
	.err {
		margin: 0 0 0.75rem;
		font-size: 0.9rem;
		color: #9f1239;
	}
	fieldset {
		border: 0;
		margin: 0 0 0.75rem;
		padding: 0;
		display: grid;
		gap: 0.4rem;
	}
	.note {
		display: grid;
		gap: 0.3rem;
		margin-bottom: 1rem;
		font-size: 0.9rem;
	}
	.note select {
		font: inherit;
		padding: 0.4rem 0.5rem;
		border: 1px solid #e4e6ea;
		border-radius: 8px;
		background: #fff;
	}
</style>
