{
  "_comment": "Optional Cursor/Claude Code MCP config. NOT the LabscriptAI product entrypoint — use `labscriptai chat`. index.js is the robot backend for mcp_adapter.call_tool (short-lived Node import of TOOL_HANDLERS), not a product CLI.",
  "mcpServers": {
    "opentrons-lab": {
      "command": "node",
      "args": [
        "labscriptai/plugins/mcp/opentrons-mcp/index.js"
      ]
    },
    "opentrons-docs": {
      "command": "npx",
      "args": [
        "-y",
        "opentrons-document-mcp-server@latest"
      ]
    }
  }
}
