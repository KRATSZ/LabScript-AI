+    top = (well.z + well.depth) * MM
+    bottom = well.z * MM
+    floor_h = min(0.0006, max(0.0002, well.depth * MM * 0.08))
+    floor_z = bottom + floor_h / 2
+    floor_rgba = "0.14 0.17 0.21 1"
+    if well.shape == "rectangular":
+        wall = 0.00055
+        sx = well.size_x * MM
+        sy = well.size_y * MM
+        outer_x, outer_y = sx + 2 * wall, sy + 2 * wall
+        cx, cy = well.x * MM, well.y * MM
+        wall_h = well.depth * MM
+        wall_geoms = [
+            shell.rbox(book, f"viz_{key}_{name}_wall_l", (cx - outer_x / 2, cy - outer_y / 2, bottom), (cx - sx / 2, cy + outer_y / 2, bottom + wall_h), "well_rim", 0.00018, 0),
