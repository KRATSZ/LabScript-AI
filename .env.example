# Copy to `.env` (gitignored) and fill values. Do not commit secrets.

# LLM (labscriptai chat --provider deepseek)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_TIMEOUT_SEC=240
DEEPSEEK_MAX_TOKENS=12000

# Robot (doctor / chat --robot; also LABSCRIPTAI_ROBOT_IP)
ROBOT_IP=

# Optional: Volcengine Ark VLM for MCP analyze_image_with_ark
# ARK_API_KEY=
# ARK_MODEL_ENDPOINT=
# ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
