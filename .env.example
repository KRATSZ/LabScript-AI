# Copy to `.env` (gitignored) and fill DEEPSEEK_API_KEY. Do not commit secrets.
# `contamination_probe` sends thinking: disabled for DeepSeek V4 so `content` is populated.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_TIMEOUT_SEC=240
DEEPSEEK_MAX_TOKENS=12000
