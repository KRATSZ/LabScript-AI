flowchart LR
  In["输入<br/>TUI / Event"] --> Bridge["UnifiedChatBridge<br/>组上下文"]
  Bridge --> State["AgentState<br/>状态快照"]
  State --> Loop["Agent Loop<br/>思考一轮"]

  Loop -->|直接| Reply["回复 TUI"]
  Loop -->|用工具| Gate["Gatekeeper<br/>安全审查"]
  Gate --> Registry["ToolRegistry<br/>分发工具"]

  Registry --> Package["Package<br/>写 / 验 / 模拟"]
  Registry --> Robot["Robot / Run<br/>看状态 / 恢复"]
  Registry --> Knowledge["Skill + Memory<br/>规则 + 经验"]
  Registry --> Support["Search + shell<br/>检索 / 检查"]

  Package --> Result["ToolResult<br/>结果 + patch"]
  Robot --> Result
  Knowledge --> Result
  Support --> Result

  Result --> State
  Result -.-> Trace["trace.jsonl<br/>证据记录"]

  classDef input fill:#eef6ff,stroke:#8fb9e8,color:#1f2937;
  classDef core fill:#ffffff,stroke:#cfd7d0,color:#1f2937;
  classDef loop fill:#fff7df,stroke:#d8b85e,color:#1f2937;
  classDef safe fill:#eef9f0,stroke:#8ac69a,color:#1f2937;
  classDef knowledge fill:#f0ecfb,stroke:#b7a6dc,color:#1f2937;
  classDef trace fill:#f6f7f5,stroke:#cfd7d0,color:#1f2937;

  class In input;
  class Bridge,State,Registry,Package,Robot,Support,Result core;
  class Loop,Gate loop;
  class Reply safe;
  class Knowledge knowledge;
  class Trace trace;
