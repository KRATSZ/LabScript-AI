{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://labscriptai.local/schemas/continuation_patch.schema.json",
  "title": "LabscriptAI continuation patch",
  "type": "object",
  "required": ["schema_version", "patch_id", "recovery_type", "operations"],
  "properties": {
    "schema_version": { "const": "0.1" },
    "patch_id": { "type": "string" },
    "recovery_type": {
      "enum": ["small_action", "alternative_resource", "continuation_protocol"]
    },
    "starts_after_command_id": { "type": ["string", "null"] },
    "human_confirmed": { "type": "boolean" },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["op_type"],
        "properties": {
          "op_type": {
            "enum": [
              "use_tip",
              "transfer",
              "resource_substitution",
              "skip",
              "comment"
            ]
          },
          "tip": { "type": "string" },
          "source_well": { "type": "string" },
          "destination_well": { "type": "string" },
          "reagent": { "type": "string" },
          "volume_ul": { "type": "number", "exclusiveMinimum": 0 },
          "from_resource": { "type": "string" },
          "to_resource": { "type": "string" },
          "required_volume_ul": { "type": "number", "minimum": 0 },
          "available_volume_ul": { "type": "number", "minimum": 0 },
          "allow_repeat": { "type": "boolean" },
          "note": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
