{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://labscriptai.local/schemas/trace_event.schema.json",
  "title": "LabscriptAI runtime trace event",
  "type": "object",
  "required": ["event_id", "timestamp", "run_id", "event_type", "actor"],
  "properties": {
    "event_id": { "type": "string" },
    "timestamp": { "type": "string" },
    "run_id": { "type": "string" },
    "event_type": {
      "enum": [
        "observation",
        "state_update",
        "memory_retrieval",
        "candidate_action",
        "gatekeeper_decision",
        "tool_call",
        "tool_result",
        "recovery",
        "escalation",
        "summary"
      ]
    },
    "actor": { "enum": ["system", "model", "gatekeeper", "tool", "human"] },
    "payload": { "type": "object", "additionalProperties": true },
    "state_hash": { "type": ["string", "null"] }
  },
  "additionalProperties": true
}
